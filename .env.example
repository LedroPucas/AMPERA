# Copie para .env e ajuste os valores.
PORT=3000
TZ_NEGOCIO=America/Sao_Paulo
TARIFA_PADRAO=0.85

# Login do painel
APP_USER=admin
APP_PASSWORD=troque-esta-senha
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio

# Envio por HTTP(S): token que o ESP32 manda no cabecalho Authorization.
# Sem DEVICE_TOKEN, a rota POST /api/leitura/<id> fica desativada.
DEVICE_TOKEN=troque-por-um-token-longo-e-aleatorio

# Em hospedagem atras de proxy (Render, Railway): TRUST_PROXY=1
TRUST_PROXY=

# MQTT_ATIVO=false desliga o MQTT (broker e ingestor); use quando o ESP32 envia por HTTP.
MQTT_ATIVO=true

# MQTT: usuario e senha que o ESP32 usa para publicar.
# Sem MQTT_URL, o servidor sobe um broker proprio na porta MQTT_PORT.
# Para a nuvem (ex.: HiveMQ Cloud): MQTT_URL=mqtts://SEU-CLUSTER.s1.eu.hivemq.cloud:8883
MQTT_URL=
MQTT_PORT=1883
MQTT_USER=ampera
MQTT_PASSWORD=troque-esta-senha

# Banco: sem DATABASE_URL, usa PostgreSQL embutido (PGlite) em ./data.
# Para a nuvem (ex.: Neon ou Supabase): DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=
